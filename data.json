"roster":[
{"n":"Batuhan Nazikoğlu","t":"kirmizi","s":"Deneyimli","sa":"Yaklaşık on yıllık gastronomi geçmişiyle sezonun ilk beyaz önlüğünü aldı."},
{"n":"Nilay Özgen","t":"kirmizi","s":"Özgüvenli","sa":"Kendinden emin tavrıyla öne çıkıyor; potaya gönderilmesine açıkça itiraz etti."},
{"n":"Hasan Alp Karabacak","t":"kirmizi","s":"Usta","sa":"Gastronomi mezunu, profesyonel mutfakta demi chef olarak çalışıyor."},
{"n":"Şiringül Kaya","t":"mavi","s":"Sanatçı","sa":"Piyanist ve besteci; mutfağa sahneden geldi."},
{"n":"Enes Vardar","t":"mavi","s":"Dirençli","sa":"Defalarca eleme adayı oldu ama her seferinde yarışmada kalmayı başardı."},
{"n":"Eyüp Can Güneş","t":"mavi","s":"Yöresel","sa":"Şanlıurfalı; tabağını Güneydoğu mutfağı ve kebap üzerine kuruyor."},
